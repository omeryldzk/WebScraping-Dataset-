    "# Function to plot residuals\n",
    "def plot_residuals(y_true, y_pred, model_name):\n",
    "    residuals = y_true - y_pred\n",
    "    plt.figure(figsize=(10, 6))\n",
    "    plt.scatter(y_pred, residuals, alpha=0.6)\n",
