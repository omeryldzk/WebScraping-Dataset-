   "source": [
    "Ridge_model = Ridge(alpha=0.1)\n",
    "Ridge_metrics = {}\n",
    "Ridge_model_year = {}\n",
    "Ridge_metrics_qerror = {}\n",
    "worst_predictions_by_year = {}\n",
    "\n",
    "for i in range(1, len(x_year)):\n",
    "    year = 2020+i-1\n",
    "    Ridge_model, pred = train(Ridge_model, x_year[i-1], y_year[i-1], x_year[i])\n",
    "    rmse, mae, r2 = evaluate(y_year[i], pred)\n",
    "    \n",
    "    # Store basic metrics\n",
    "    Ridge_metrics[year] = {'RMSE': rmse, 'MAE': mae, 'R2': r2}\n",
    "    Ridge_metrics_qerror[year] = evaluate_with_qerror(y_year[i], pred)\n",
    "    Ridge_model_year[year] = Ridge_model\n",
    "    \n",
    "    print(f\"\\nYear {year} Metrics:\")\n",
    "    print(f\"RMSE: {rmse:.4f}, MAE: {mae:.4f}, R^2: {r2:.4f}\")\n",
    "    \n",
    "    # Analyze and visualize worst predictions\n",
    "    worst_predictions_df = visualize_worst_predictions(y_year[i], pred, year)\n",
